{
  "_comment": "What answers on an open port. Each rule: one or more of title, server, header ('Name: regex'), location, body, banner — case-insensitive regular expressions, all of which must match — and the name, protocol and dashboard-icons slug it means. First match wins; keep it generic (common self-hosted software), never one homelab's names. Loaded by app/fingerprint.py.",
  "rules": [
    {"banner": "^SSH-", "name": "SSH", "protocol": "ssh"},
    {"banner": "^RFB \\d", "name": "VNC", "protocol": "vnc"},
    {"banner": "^220[ -].*(ftp|filezilla)", "name": "FTP", "protocol": "ftp"},
    {"banner": "^220[ -].*(smtp|esmtp|postfix|exim)", "name": "SMTP", "protocol": "smtp"},
    {"banner": "^\\* OK .*IMAP", "name": "IMAP", "protocol": "imap"},

    {"title": "Proxmox Backup Server", "name": "Proxmox Backup Server", "icon": "proxmox"},
